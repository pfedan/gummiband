{
    "$schema": "https://go.kicad.org/api/schemas/v1",
    "identifier": "com.github.pfedan.gummiband",
    "name": "Gummiband",
    "description": "Topological rubber band autorouter: routes the open board with the gummiband CLI and imports the tracks and vias as one undo step.",
    "runtime": {
        "type": "python",
        "min_version": "3.9"
    },
    "actions": [
        {
            "identifier": "route",
            "name": "Route with Gummiband",
            "description": "Route the open board with Gummiband and replace its tracks and vias",
            "show-button": true,
            "scopes": [
                "pcb"
            ],
            "entrypoint": "gummiband_action.py",
            "icons-light": [
                "icons/gummiband-light-24.png",
                "icons/gummiband-light-48.png"
            ],
            "icons-dark": [
                "icons/gummiband-dark-24.png",
                "icons/gummiband-dark-48.png"
            ]
        },
        {
            "identifier": "finish",
            "name": "Finish selected nets with Gummiband",
            "description": "Keep all copper and route what is missing on the nets of the selected tracks, vias or pads",
            "show-button": true,
            "scopes": [
                "pcb"
            ],
            "entrypoint": "gummiband_finish.py",
            "icons-light": [
                "icons/finish-light-24.png",
                "icons/finish-light-48.png"
            ],
            "icons-dark": [
                "icons/finish-dark-24.png",
                "icons/finish-dark-48.png"
            ]
        },
        {
            "identifier": "angles45",
            "name": "45 degree tracks with Gummiband",
            "description": "Turn the unlocked tracks into conventional 45 degree tracks without routing again: the nets of the selection, or all nets; vias, track ends and locked tracks stay",
            "show-button": true,
            "scopes": [
                "pcb"
            ],
            "entrypoint": "gummiband_angles.py",
            "icons-light": [
                "icons/angles-light-24.png",
                "icons/angles-light-48.png"
            ],
            "icons-dark": [
                "icons/angles-dark-24.png",
                "icons/angles-dark-48.png"
            ]
        },
        {
            "identifier": "place",
            "name": "Place with Gummiband",
            "description": "Place the parts from the netlist; locked parts, connectors, modules, mounting holes, buttons and test points stay",
            "show-button": true,
            "scopes": [
                "pcb"
            ],
            "entrypoint": "gummiband_place.py",
            "icons-light": [
                "icons/place-light-24.png",
                "icons/place-light-48.png"
            ],
            "icons-dark": [
                "icons/place-dark-24.png",
                "icons/place-dark-48.png"
            ]
        }
    ]
}
